{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,

    "moduleResolution": "node16",

    "types": ["node"],

    "esModuleInterop": true,

    "skipLibCheck": true
  },

  "include": [
    "src/**/*",
    "prisma.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}